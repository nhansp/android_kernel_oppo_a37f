/* OPPO A37f (project 15399) — MSM8916 / Snapdragon 410, arm64 boot port.
 * Device hardware ported from the live /proc/device-tree dump
 * (~/a37f-dumps/live-refs/live-dt). Every node/value is grounded there;
 * see KERNEL-DT-PORT.md for the source->live-dt trace per node.
 */

/dts-v1/;

#include "msm8916-mtp.dtsi"
#include "msm8916-memory.dtsi"
#include "dsi-panel-oppo15399-video.dtsi"
#include "batterydata-oppo15399.dtsi"

/ {
	model = "OPPO A37f (15399)";
	compatible = "qcom,msm8916-mtp", "qcom,msm8916", "qcom,mtp";
	/* board-id: project 15399 — must match downstream lk selection */
	qcom,board-id = <8 0 15399>;

	/* pstore/ramoops: persistent RAM for post-mortem logs (ramoops).
	 * base 0x9ff00000 confirmed against ~/a37f-dumps/raw/cmdline.txt ramoops.
	 */
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		ramoops_mem: ramoops_region@9ff00000 {
			reg = <0x0 0x9ff00000 0x0 0x00100000>;
			label = "ramoops_mem";
			no-map;
		};
	};

	ramoops {
		compatible = "ramoops";
		memory-region = <&ramoops_mem>;
		record-size  = <0x20000>;
		console-size = <0x40000>;
		ftrace-size  = <0x20000>;
		pmsg-size    = <0x20000>;
	};
};

/* USB: A37f has no PMIC VBUS path (bq24196 charger absent) -> use PHY OTG
 * control so the port comes up for adb. (base dtsi sets =2 PMIC_CONTROL)
 */
&usb_otg {
	qcom,hsusb-otg-otg-control = <1>; /* OTG_PHY_CONTROL */
};

/* ---------------------------------------------------------------------------
 * CPU rail (BOOT-CRITICAL): external NCP6335D buck on BLSP1 QUP1 (i2c@78b5000)
 *
 * The base msm8916 kernel leaves the APC/CPR rail on the internal pm8916_s2
 * SPM regulator only. The real A37f drives VDD_APC through an external
 * ON Semi NCP6335D buck (addr 0x1c) which the CPR loop selects via
 * vdd-apc-optional-prim-supply. i2c@78b5000 (QUP1) is not instantiated by
 * the base msm8916.dtsi, so we add it here (BAM pipes 4/5, irq 95).
 *
 * Ground truth: live-dt/soc/i2c@78b5000/ + .../ncp6335d-regulator@1c/
 * Bus template: msm8909.dtsi i2c_1 (identical BLSP1 QUP1 on shared GCC).
 * ------------------------------------------------------------------------- */

/* i2c_1 pinmux (GPIO 2/3, func 3) — live-dt/soc/pinctrl@1000000/pmx_i2c_1 */
&tlmm_pinmux {
	pmx_i2c_1 {
		/* CLK, DATA */
		qcom,pins = <&gp 2>, <&gp 3>;
		qcom,num-grp-pins = <2>;
		qcom,pin-func = <3>;
		label = "pmx_i2c_1";

		i2c_1_active: i2c_1_active {
			drive-strength = <2>; /* 2 MA */
			bias-disable = <0>;   /* No PULL */
		};

		i2c_1_sleep: i2c_1_sleep {
			drive-strength = <2>; /* 2 MA */
			bias-disable = <0>;   /* No PULL */
		};
	};
};

&soc {
	i2c_1: i2c@78b5000 { /* BLSP1 QUP1 */
		compatible = "qcom,i2c-msm-v2";
		#address-cells = <1>;
		#size-cells = <0>;
		reg-names = "qup_phys_addr";
		reg = <0x78b5000 0x1000>;
		interrupt-names = "qup_irq";
		interrupts = <0 95 0>;
		clocks = <&clock_gcc clk_gcc_blsp1_ahb_clk>,
			 <&clock_gcc clk_gcc_blsp1_qup1_i2c_apps_clk>;
		clock-names = "iface_clk", "core_clk";
		qcom,clk-freq-out = <100000>;
		qcom,clk-freq-in  = <19200000>;
		pinctrl-names = "i2c_active", "i2c_sleep";
		pinctrl-0 = <&i2c_1_active>;
		pinctrl-1 = <&i2c_1_sleep>;
		qcom,noise-rjct-scl = <0>;
		qcom,noise-rjct-sda = <0>;
		dmas = <&dma_blsp1 4 64 0x20000020 0x20>,
			<&dma_blsp1 5 32 0x20000020 0x20>;
		dma-names = "tx", "rx";
		qcom,master-id = <86>;

		/* ON Semi NCP6335D external buck (VDD_APC).
		 * live-dt/soc/i2c@78b5000/ncp6335d-regulator@1c
		 * onnn,* decoded from BE u32: slew=3333 step=6250 min-slew=416
		 * max-slew=3333 min-setpoint=600000 vsel-gpio=<gpio111 flag1>.
		 * (Live pinctrl on this node was typo'd "pintrl-names" -> never
		 * applied; the driver drives gpio 111 directly, so pinctrl omitted.)
		 */
		ncp6335d: ncp6335d-regulator@1c {
			compatible = "onnn,ncp6335d-regulator";
			reg = <0x1c>;
			onnn,vsel = <0>;
			onnn,slew-ns = <3333>;
			onnn,step-size = <6250>;
			onnn,min-slew-ns = <416>;
			onnn,max-slew-ns = <3333>;
			regulator-min-microvolt = <1050000>;
			regulator-max-microvolt = <1350000>;
			onnn,min-setpoint = <600000>;
			onnn,vsel-gpio = <&msm_gpio 111 1>;
			onnn,discharge-enable;
			onnn,restore-reg;
		};
	};
};

/* Retarget the CPR loop onto the external NCP6335D buck.
 * live-dt/soc/regulator@b018000: vdd-apc-optional-prim-supply -> ncp6335d
 * (phandle match), while vdd-apc-supply stays on pm8916_s2 (base default).
 */
&apc_vreg_corner {
	vdd-apc-optional-prim-supply = <&ncp6335d>;
};

/* ---------------------------------------------------------------------------
 * Display: select the real A37f DSI panels over the base mtp jdi panel.
 * live-dt/soc/qcom,mdss_dsi@1a98000: dsi-pref-prim-pan=boe (0x67),
 * sub=tm_nt35521s (0x6c), sub1=truly_nt35521s (0x6d). Reset/enable/bklight
 * GPIOs (25/97/98) already match the mtp base, so only panel selection here.
 * Panel nodes live in dsi-panel-oppo15399-video.dtsi (ported from live-dt).
 * ------------------------------------------------------------------------- */
&mdss_dsi0 {
	qcom,dsi-pref-prim-pan = <&dsi_oppo15399boe_ili9881c>;
	qcom,dsi-pref-sub-pan  = <&dsi_oppo15399tm_nt35521s>;
	qcom,dsi-pref-sub1-pan = <&dsi_oppo15399truly_nt35521s>;
};

/* ---------------------------------------------------------------------------
 * Touch: Synaptics S3203 on i2c_5 (i2c@78b9000) addr 0x20 + TI LM3630 backlight
 * (addr 0x38). The base mtp carries a "synaptics,rmi4" node with 1080p coords
 * and reset-gpio 12 — wrong for the A37f — so it (and the mtp 1080p gen-vkeys)
 * is removed and replaced with the real S3203 config.
 *
 * Ground truth: live-dt/soc/i2c@78b9000/synaptics15009@20/ and ti_lm3630_bl@38/
 * NOTE: this LineageOS msm8916 tree has NO "synaptics-s3203" touch driver, so
 * the node is faithful-but-inert until that OPPO TP driver is ported; the DT is
 * ready. lm3630_bl.c IS present (i2c id "lm3630_bl").
 * ------------------------------------------------------------------------- */

/* TP panel-ID detect gpios — live-dt/soc/pinctrl@1000000/tp_gpio_id{1,2,3}_config
 * (gpio 109/114/119; active=pull-up, sleep=pull-down). ts_int_active (gpio 13)
 * already exists in msm8916-pinctrl.dtsi and is reused.
 */
&tlmm_pinmux {
	tp_gpio_id1_config {
		qcom,pins = <&gp 109>;
		qcom,pin-func = <0>;
		qcom,num-grp-pins = <1>;
		label = "tp_gpio_id1_config";
		tp_gpio_id1_active: active {
			drive-strength = <2>;
			bias-pull-up;
		};
		tp_gpio_id1_sleep: sleep {
			drive-strength = <2>;
			bias-pull-down;
		};
	};

	tp_gpio_id2_config {
		qcom,pins = <&gp 114>;
		qcom,pin-func = <0>;
		qcom,num-grp-pins = <1>;
		label = "tp_gpio_id2_config";
		tp_gpio_id2_active: active {
			drive-strength = <2>;
			bias-pull-up;
		};
		tp_gpio_id2_sleep: sleep {
			drive-strength = <2>;
			bias-pull-down;
		};
	};

	tp_gpio_id3_config {
		qcom,pins = <&gp 119>;
		qcom,pin-func = <0>;
		qcom,num-grp-pins = <1>;
		label = "tp_gpio_id3_config";
		tp_gpio_id3_active: active {
			drive-strength = <2>;
			bias-pull-up;
		};
		tp_gpio_id3_sleep: sleep {
			drive-strength = <2>;
			bias-pull-down;
		};
	};
};

&i2c_5 {
	/* drop the base mtp rmi4 (1080p, reset-gpio 12) — not the A37f part */
	/delete-node/ synaptics@20;

	synaptics15009@20 {
		compatible = "synaptics-s3203";
		reg = <0x20>;
		interrupt-parent = <&msm_gpio>;
		interrupts = <13 0x2008>;
		vdd_2v8-supply = <&pm8916_l17>;
		vcc_i2c_1v8-supply = <&pm8916_l6>;
		pinctrl-names = "default", "tp_id_pull_up", "tp_id_pull_down";
		pinctrl-0 = <&ts_int_active &tp_gpio_id1_active
			     &tp_gpio_id2_active &tp_gpio_id3_active>;
		pinctrl-1 = <&tp_gpio_id1_active &tp_gpio_id2_active
			     &tp_gpio_id3_active>;
		pinctrl-2 = <&tp_gpio_id1_sleep &tp_gpio_id2_sleep
			     &tp_gpio_id3_sleep>;
		synaptics,irq-gpio = <&msm_gpio 13 0x2008>;
		synaptics,id1-gpio = <&msm_gpio 109 0>;
		synaptics,id2-gpio = <&msm_gpio 114 0>;
		synaptics,id3-gpio = <&msm_gpio 119 0>;
		synaptics,tx-rx-num = <13 23>;
		synaptics,panel-coords = <1100 1745>;
		synaptics,display-coords = <720 1280>;
		synaptics,max-num-support = <10>;
		synaptics,max-x-point = <10>;
		synaptics,button-map = <100 140 1400>;
		synaptics,black-gesture-enabled;
		synaptics,i2c-pull-up;
		synaptics,disable-gpios;
		synaptics,power-down;
	};

	ti_lm3630_bl@38 {
		compatible = "lm3630_bl";
		reg = <0x38>;
		bl_i2c_1v8-supply = <&pm8916_l6>;
		ti,bl-enable-gpio = <&msm_gpio 69 0>;
		ti,bank-a-ctrl = <0x05>;
		ti,init-brt-led1 = <0xc8>;
		ti,init-brt-led2 = <0xc8>;
		ti,max-brt-led1 = <0xff>;
		ti,max-brt-led2 = <0xff>;
		ti,pwm-period = <0xff>;
		ti,pwm-ctrl = <0x00>;
		ti,pwm-active = <0x00>;
	};
};

/* Remove the base mtp virtual-key map (1080p / synaptics_rmi4_i2c); the A37f
 * S3203 carries its own synaptics,button-map and the live device has no gen-vkeys.
 */
&soc {
	/delete-node/ gen-vkeys;
};

/* ---------------------------------------------------------------------------
 * Battery FG: point the pm8916 voltage-mode BMS at the real A37f OPPO profiles
 * (7 profiles: atl/lg/sdi/sony 4v35 + high atl/lg/sdi 4v4) instead of the base
 * mtp palladium profile. Data in batterydata-oppo15399.dtsi (ported from
 * live-dt/qcom,battery-data-*).
 * ------------------------------------------------------------------------- */
&pm8916_bms {
	qcom,battery-data = <&oppo_batterydata>;
};
